# ==============================================================================
# CropDiary AI — Environment Configuration Template
# All VITE_* variables are bundled into the client application.
# Do NOT store real production secrets or private database keys here.
# ==============================================================================

# --- Database & Authentication (Supabase Cloud PostgreSQL) ---
# When configured, CropDiary AI connects to Supabase Cloud with PostgreSQL Row-Level Security.
# When left blank or absent, the platform automatically runs in "Local Development Mode"
# using an isolated browser-side storage adapter and native IndexedDB offline synchronization.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-placeholder

# --- AI Vision & Conversational AI (Crop Doctor & AI Assistant) ---
# Gemini, Meta Model, and WeatherAPI keys are server-side secrets managed in Supabase Edge Functions.
# Never expose them to client-side bundles or VITE_* variables.
# Set via Supabase CLI:
#   supabase secrets set GEMINI_API_KEY="your_gemini_api_key"
#   supabase secrets set MODEL_API_KEY="your_meta_api_key"
#   supabase secrets set WEATHER_API_KEY="your_weatherapi_key"
# Fallback: When omitted, CropDiary AI seamlessly uses its embedded ICAR/TNAU agronomic rulebase
# and public Open-Meteo meteorological feed.
VITE_AI_VISION_API_KEY=

# --- Real-Time Agricultural Market Prices (Data.gov.in / Agmarknet) ---
# Optional: Set your data.gov.in API key to stream real-time intraday mandi prices.
# Fallback: When omitted, displays verified Directorate of Marketing & Inspection (DMI) benchmarks.
VITE_DATAGOV_API_KEY=

# --- Meteorological Weather Provider (Open-Meteo) ---
# Optional: Open-Meteo enterprise key (standard tier works out of the box with zero keys).
VITE_OPEN_METEO_API_KEY=

# --- Sentry Production Observability & Error Tracking ---
# Optional: Set your Sentry client DSN to stream unhandled client exceptions and traces.
VITE_SENTRY_DSN=

# --- Application Environment Mode ---
VITE_APP_ENV=development
